#!/usr/bin/env python3
"""Raise the existing Codex desktop window, or launch it if none is open."""
import json
import re
import subprocess

clients = json.loads(subprocess.check_output(['hyprctl', 'clients', '-j'], text=True))
windows = [c for c in clients if c.get('class', '').lower() in ('chatgpt', 'codex') and c.get('mapped')]
if windows:
    window = min(windows, key=lambda c: c.get('focusHistoryID', 9999))
    address = window['address']
    if not re.fullmatch(r'0x[0-9a-fA-F]+', address):
        raise SystemExit('Invalid window address')
    subprocess.run(['hyprctl', 'eval', f'hl.dispatch(hl.dsp.focus({{window = "address:{address}"}}))'], check=True)
else:
    subprocess.Popen(['uwsm-app', '--', 'chatgpt'], start_new_session=True)
